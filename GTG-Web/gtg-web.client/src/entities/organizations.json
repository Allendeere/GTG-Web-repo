{
    "name": "organizations",
    "options": {
        "validator": {
            "$jsonSchema": {
                "bsonType": "object",
                "required": [ "name", "type", "contactPerson", "phone", "location", "status", "createdAt" ],
                "properties": {
                    "name": {
                        "bsonType": "string",
                        "description": "組織或團隊名稱"
                    },
                    "type": {
                        "bsonType": "string",
                        "enum": [ "disaster_response", "communication", "logistics", "research", "support" ],
                        "description": "組織類型"
                    },
                    "contactPerson": {
                        "bsonType": "string",
                        "description": "聯絡人姓名"
                    },
                    "phone": {
                        "bsonType": "string",
                        "description": "聯絡電話"
                    },
                    "email": {
                        "bsonType": "string",
                        "description": "電子郵件"
                    },
                    "location": {
                        "bsonType": "object",
                        "properties": {
                            "address": { "bsonType": "string" },
                            "coordinates": {
                                "bsonType": "object",
                                "properties": {
                                    "lat": { "bsonType": "number" },
                                    "lng": { "bsonType": "number" }
                                }
                            }
                        }
                    },
                    "status": {
                        "bsonType": "string",
                        "enum": [ "active", "standby", "emergency", "offline" ],
                        "description": "組織狀態"
                    },
                    "capabilities": {
                        "bsonType": "array",
                        "items": { "bsonType": "string" },
                        "description": "組織能力清單"
                    },
                    "createdAt": {
                        "bsonType": "string",
                        "title": "datetime",
                        "description": "建立時間"
                    },
                    "updatedAt": {
                        "bsonType": "string",
                        "title": "datetime",
                        "description": "更新時間"
                    }
                },
                "additionalProperties": true
            }
        },
        "validationLevel": "moderate",
        "validationAction": "warn"
    }
}
