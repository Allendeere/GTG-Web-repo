{
    "name": "spiritual_support",
    "options": {
        "validator": {
            "$jsonSchema": {
                "bsonType": "object",
                "required": [ "title", "type", "content", "category", "isActive", "createdAt" ],
                "properties": {
                    "title": {
                        "bsonType": "string",
                        "description": "標題"
                    },
                    "type": {
                        "bsonType": "string",
                        "enum": [ "scripture", "prayer", "community_activity", "counseling", "encouragement" ],
                        "description": "支持類型"
                    },
                    "content": {
                        "bsonType": "string",
                        "description": "內容"
                    },
                    "category": {
                        "bsonType": "string",
                        "enum": [ "hope", "courage", "peace", "strength", "guidance", "comfort" ],
                        "description": "主題分類"
                    },
                    "reference": {
                        "bsonType": "string",
                        "description": "聖經經文出處"
                    },
                    "tags": {
                        "bsonType": "array",
                        "items": { "bsonType": "string" },
                        "description": "標籤"
                    },
                    "isActive": {
                        "bsonType": "bool",
                        "description": "是否啟用"
                    },
                    "viewCount": {
                        "bsonType": "number",
                        "minimum": 0,
                        "description": "瀏覽次數"
                    },
                    "createdAt": {
                        "bsonType": "string",
                        "title": "datetime",
                        "description": "建立時間"
                    },
                    "updatedAt": {
                        "bsonType": "string",
                        "title": "datetime",
                        "description": "更新時間"
                    }
                },
                "additionalProperties": true
            }
        },
        "validationLevel": "moderate",
        "validationAction": "warn"
    }
}
